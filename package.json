{
  "name": "keen-switch",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome extension that switches this device between Keenetic routing policies in one click",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dsamoylenko/keen_switch.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "build:release": "npm run typecheck && vite build --mode release && rm -rf dist/icons-dev",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "test": "node scripts/test.mjs",
    "package": "npm run build:release && node scripts/package.mjs",
    "icons:dev": "node scripts/generate-dev-icons.mjs"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@types/chrome": "^0.0.297",
    "@types/node": "^26.2.0",
    "sharp": "^0.35.4",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
